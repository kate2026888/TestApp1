  "BuiltInViewInfo": {
    "ViewName": "View2",
    "SourceViewName": "fgc01b97a87591441a08cd4e0f152d",
    "CreateViewSql": "WITH RankedProducts AS (\r\n    SELECT\r\n        p.ID,\r\n        p.name,\r\n        c.name AS CateName,\r\n        CAST(YEAR(o.Date_and_Time) AS INTEGER) AS Year,\r\n        SUM(oi.quantity * p.price) AS TotalAmount,\r\n        CAST(\r\n            RANK() OVER (\r\n                PARTITION BY c.ID, YEAR(o.Date_and_Time)\r\n                ORDER BY SUM(oi.quantity * p.price) DESC\r\n            ) AS INT\r\n        ) AS RankInCategory\r\n    FROM OrderItems oi\r\n    JOIN Products p \r\n        ON oi.Product_id = p.ID\r\n    JOIN Categories c \r\n        ON p.category_id = c.ID\r\n    JOIN Orders o\r\n        ON oi.Order_id = o.ID\r\n    GROUP BY \r\n        p.ID,\r\n        p.name,\r\n        c.name,\r\n        c.ID,\r\n        YEAR(o.Date_and_Time)\r\n)\r\nSELECT *\r\nFROM RankedProducts\r\nWHERE RankInCategory <= 3\r\nORDER BY Year DESC, CateName, RankInCategory, TotalAmount DESC"
  },
  "PrimaryKey": [
    "ID"
  ],
  "Indexes": []
}